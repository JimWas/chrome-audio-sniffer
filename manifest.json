{
  "manifest_version": 3,
  "name": "Audio Finder & Recorder",
  "version": "1.1.0",
  "description": "Find downloadable audio requests and record audio playing in the current tab.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "downloads", "offscreen", "storage", "tabCapture", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Find audio" }
}
