{
  "manifest_version": 3,
  "name": "Audio Finder & Recorder",
  "version": "1.1.1",
  "description": "Find downloadable audio requests and record audio playing in the current tab.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "downloads", "offscreen", "storage", "tabCapture", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find audio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
